<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SmartLanche.Presentation.Converters">

    <!-- Estilo Base para todos os ComboBox da aplicação -->
    <Style x:Key="BaseComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="False"/>
    </Style>

    <!-- Estilo para ComboBox de Filtro (listas) - herda do Base -->
    <Style x:Key="FilterComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="ComboBox">
        <Setter Property="Width" Value="180"/>
        <Setter Property="Height" Value="34"/>
    </Style>

    <!-- Estilo para ComboBox em Formulários - herda do Base -->
    <Style x:Key="FormComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="ComboBox">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="200"/>
    </Style>

    <!-- Estilo para ComboBox em Diálogos - herda do Base -->
    <Style x:Key="DialogComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="ComboBox">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="180"/>
    </Style>

    <!-- Estilo para ComboBox no ProductPicker - herda do Base -->
    <Style x:Key="PickerComboBoxStyle" BasedOn="{StaticResource BaseComboBoxStyle}" TargetType="ComboBox">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="150"/>
    </Style>

    <!-- ItemContainerStyle padrão para melhor aparência dos itens -->
    <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Converter para enums (já existe no projeto, mas referenciado aqui para uso) -->
    <local:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>

</ResourceDictionary>