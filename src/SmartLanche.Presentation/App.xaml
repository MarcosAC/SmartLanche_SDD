<Application x:Class="SmartLanche.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters">
    <Application.Resources>
        <converters:ToastIconConverter x:Key="ToastIconConverter"/>
        <converters:ToastColorConverter x:Key="ToastColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:OrderStatusToVisibilityConverter x:Key="OrderStatusToVisibilityConverter"/>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter"/>

        <DropShadowEffect x:Key="ToastShadowEffect"
                          BlurRadius="12"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#33000000"/>

        <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="48"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F9FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DBEAFE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
