<UserControl x:Class="SmartLanche.Presentation.Controls.ToastContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartLanche.Presentation.Controls"
             xmlns:services="clr-namespace:SmartLanche.Presentation.Services">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type services:ToastItem}">
            <Border x:Name="ToastBorder"
                    Margin="0,0,0,8"
                    Padding="16,12"
                    CornerRadius="8"
                    BorderThickness="1"
                    Background="White"
                    Effect="{StaticResource ToastShadowEffect}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform X="400" Y="0"/>
                </Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                 From="400" To="0"
                                                 Duration="0:0:0.3"
                                                 DecelerationRatio="0.8"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Success">
                                <Setter Property="BorderBrush" Value="#16A34A"/>
                                <Setter Property="Background" Value="#F0FDF4"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Error">
                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                <Setter Property="Background" Value="#FEF2F2"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Warning">
                                <Setter Property="BorderBrush" Value="#F59E0B"/>
                                <Setter Property="Background" Value="#FFFBEB"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Info">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Background" Value="#EFF6FF"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Type, Converter={StaticResource ToastIconConverter}}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               Foreground="{Binding Type, Converter={StaticResource ToastColorConverter}}"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Message}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="#1F2937"/>
                    <Button Grid.Column="2"
                            Content="✕"
                            FontSize="11"
                            Padding="6,2"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#9CA3AF"
                            Cursor="Hand"
                            Command="{Binding DismissCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding Id}"
                            ToolTip="Dispensar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder" Background="Transparent" Padding="4">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#E5E7EB"/>
                                        <Setter TargetName="BtnBorder" Property="CornerRadius" Value="4"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl ItemsSource="{Binding Toasts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Right">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>