<UserControl x:Class="SmartLanche.Presentation.Views.Inventory.InventoryMovementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:SmartLanche.Presentation.ViewModels.Inventory"
             xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:domainEnums="clr-namespace:SmartLanche.Domain.Enums;assembly=SmartLanche.Domain"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InventoryMovementsViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="600" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:MovementTypeToDescriptionConverter x:Key="MovementTypeToDescriptionConverter"/>
        <converters:MovementOriginToDescriptionConverter x:Key="MovementOriginToDescriptionConverter"/>
        <converters:MovementTypeToColorConverter x:Key="MovementTypeToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StringIsNullOrEmptyToVisibilityConverter x:Key="StringIsNullOrEmptyToVisibilityConverter"/>

        <ObjectDataProvider x:Key="MovementTypeValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domainEnums:MovementType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="MovementOriginValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="domainEnums:MovementOrigin"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + Toolbar (Row 0) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Movimentações de Estoque" FontSize="24" FontWeight="Bold" Foreground="#1F2937"/>
                <TextBlock Text="{Binding StatusText}" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#64748B" Foreground="White"
                        Padding="12,6" Content="⟳ Atualizar"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"/>
            </StackPanel>
        </Grid>

        <!-- Filter Bar (Row 1) -->
        <Border Grid.Row="1" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <!-- Data Inicial -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="De:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#374151"/>
                    <DatePicker SelectedDate="{Binding Filter.DateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="140" FontSize="13" Padding="4,2" BorderBrush="#D1D5DB" BorderThickness="1"/>
                </StackPanel>

                <!-- Data Final -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Até:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#374151"/>
                    <DatePicker SelectedDate="{Binding Filter.DateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                Width="140" FontSize="13" Padding="4,2" BorderBrush="#D1D5DB" BorderThickness="1"/>
                </StackPanel>

                <!-- Tipo -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Tipo:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding Source={StaticResource MovementTypeValues}}"
                              SelectedItem="{Binding Filter.Type, Mode=TwoWay}"
                              Width="140">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource MovementTypeToDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Origem -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Origem:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding Source={StaticResource MovementOriginValues}}"
                              SelectedItem="{Binding Filter.Origin, Mode=TwoWay}"
                              Width="140">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource MovementOriginToDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Produto -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Produto:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#374151"/>
                    <ComboBox Style="{StaticResource FilterComboBoxStyle}"
                              ItemsSource="{Binding Products}"
                              SelectedValue="{Binding Filter.ProductId, Mode=TwoWay}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              Width="200" IsEditable="True" IsTextSearchEnabled="True"
                              Text="{Binding Filter.ProductId, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}, FallbackValue='Todos', TargetNullValue='Todos'}"/>
                </StackPanel>

                <!-- Buttons -->
                <Button Command="{Binding LoadCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#2563EB" Foreground="White"
                        Padding="14,5" Content="🔍 Filtrar"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"/>

                <Button Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#64748B" Foreground="White"
                        Padding="14,5" Content="🧹 Limpar"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"/>
            </StackPanel>
        </Border>

        <!-- Loading Overlay (spans Row 1 and 2) -->
        <Border Grid.Row="1" Grid.RowSpan="2" Background="#80FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="10">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Carregando..." FontSize="16" Foreground="#374151"/>
                <ProgressBar Width="200" Height="6" IsIndeterminate="True" Margin="0,12,0,0" Foreground="#2563EB"/>
            </StackPanel>
        </Border>

        <!-- Data Grid (spans Row 1 and 2) - DIRECTLY in Border -->
        <Border Grid.Row="1" Grid.RowSpan="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Padding="0"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">

            <DataGrid ItemsSource="{Binding Movements}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      RowHeaderWidth="0"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      AlternatingRowBackground="#FAFAFA">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data/Hora" Binding="{Binding CreatedAt, StringFormat='dd/MM/yyyy HH:mm'}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Produto" Binding="{Binding ProductName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Tipo" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Type, Converter={StaticResource MovementTypeToColorConverter}}"
                                        CornerRadius="12" Padding="6,2" HorizontalAlignment="Center" MinWidth="70">
                                    <TextBlock Text="{Binding Type, Converter={StaticResource MovementTypeToDescriptionConverter}}"
                                               FontSize="11" FontWeight="Medium" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Origem" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Origin, Converter={StaticResource MovementOriginToDescriptionConverter}}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#374151"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Qtd" Binding="{Binding Quantity}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Qtd Anterior" Binding="{Binding PreviousQuantity}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Qtd Atual" Binding="{Binding NewQuantity}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Valor Unit." Binding="{Binding UnitPrice, StringFormat='{}R$ {0:N2}'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Valor Total" Binding="{Binding TotalValue, StringFormat='{}R$ {0:N2}'}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Margin" Value="0,0,12,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Referência" Binding="{Binding ReferenceId, FallbackValue='—'}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Observação" Binding="{Binding Note, FallbackValue='—'}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Summary Row (Footer) -->
        <Border Grid.Row="2" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="0,0,8,8" Padding="16"
                Visibility="{Binding Summary, Converter={StaticResource BoolToVisibilityConverter}}"
                Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <TextBlock Text="Entradas:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Summary.TotalEntries, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#16A34A" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <TextBlock Text="Saídas:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Summary.TotalExits, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <TextBlock Text="Saldo:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Summary.NetQuantity, StringFormat='{}{0:+#;-#;0}'}" FontSize="14" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,32,0">
                    <TextBlock Text="Valor Entradas:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Summary.TotalEntryValue, StringFormat='{}R$ {0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#16A34A" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Valor Saídas:" FontSize="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Summary.TotalExitValue, StringFormat='{}R$ {0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="#DC2626" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Empty State - SIBLING Border at same position -->
        <Border Grid.Row="1" Grid.RowSpan="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                Visibility="{Binding Movements.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=reverse}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="Nenhuma movimentação encontrada" FontSize="18" FontWeight="SemiBold" Foreground="#374151" HorizontalAlignment="Center" Margin="0,16,0,8"/>
                <TextBlock Text="Ajuste os filtros para visualizar movimentações" FontSize="14" Foreground="#64748B" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>