<UserControl x:Class="SmartLanche.Presentation.Views.Orders.OrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters"
             Background="#F5F6FA">

    <UserControl.Resources>
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="SuccessButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
        </Style>

        <Style x:Key="SearchTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#9CA3AF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusCellStyle"
               TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StatusCellWithTriggersStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource StatusCellStyle}">
            <Setter Property="Text" Value="Cancelado"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}"
                             Value="1">
                    <Setter Property="Text" Value="Pendente"/>
                    <Setter Property="Foreground" Value="#2563EB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="2">
                    <Setter Property="Text" Value="Em Preparo"/>
                    <Setter Property="Foreground" Value="#F59E0B"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="3">
                    <Setter Property="Text" Value="Pronto"/>
                    <Setter Property="Foreground" Value="#16A34A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="4">
                    <Setter Property="Text" Value="Finalizado"/>
                    <Setter Property="Foreground" Value="#059669"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}"
                             Value="5">
                    <Setter Property="Text" Value="Cancelado"/>
                    <Setter Property="Foreground" Value="#6B7280"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Pedidos"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>

                <TextBlock Text="Consulte e gerencie os pedidos."
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#6B7280"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="+ Novo pedido"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding NewItemCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- Filtros -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Buscar:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="#374151"/>

                <TextBox Grid.Column="1"
                         Height="34"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBoxStyle}"/>

                <TextBlock Grid.Column="2"
                           Text="Status:"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0"
                           Foreground="#374151"/>

                <ComboBox Grid.Column="3"
                          Height="34"
                          VerticalContentAlignment="Center"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}">
                    <ComboBoxItem Content="Todos" Tag="{x:Null}"/>
                    <ComboBoxItem Content="Pendente" Tag="1"/>
                    <ComboBoxItem Content="Em Preparo" Tag="2"/>
                    <ComboBoxItem Content="Pronto" Tag="3"/>
                    <ComboBoxItem Content="Finalizado" Tag="4"/>
                    <ComboBoxItem Content="Cancelado" Tag="5"/>
                </ComboBox>

                <TextBlock Grid.Column="4"
                           Text="Data Início:"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0"
                           Foreground="#374151"/>

                <DatePicker Grid.Column="5"
                            Height="34"
                            SelectedDate="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Grid.Column="6"
                           Text="Data Fim:"
                           VerticalAlignment="Center"
                           Margin="16,0,8,0"
                           Foreground="#374151"/>

                <DatePicker Grid.Column="7"
                            Height="34"
                            SelectedDate="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}"/>

                <Button Grid.Column="9"
                        Content="Atualizar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoadCommand}"/>
            </Grid>
        </Border>

        <!-- Listagem -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Padding="12">

            <Grid>
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserSortColumns="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          Background="White"
                          AlternatingRowBackground="#F9FAFB"
                          Sorting="DataGrid_Sorting">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding Id}"
                                            Width="80"/>

                        <DataGridTextColumn Header="Data/Hora"
                                            Binding="{Binding OrderDate, StringFormat='dd/MM/yyyy HH:mm'}"
                                            Width="140"/>

                        <DataGridTextColumn Header="Cliente"
                                            Binding="{Binding CustomerName}"
                                            Width="2*"/>

                        <DataGridTemplateColumn Header="Status"
                                                Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource StatusCellWithTriggersStyle}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Total (R$)"
                                            Binding="{Binding TotalAmount, StringFormat='C2', ConverterCulture='pt-BR'}"
                                            Width="120"/>

                        <DataGridTemplateColumn Header="Ações"
                                                Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Content="Ver"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Padding="8,4"
                                                MinWidth="55"
                                                Command="{Binding DataContext.ViewOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Em Preparo"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="8,4"
                                                MinWidth="80"
                                                Command="{Binding DataContext.StartPreparationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=1}"/>
                                        <Button Content="Pronto"
                                                Style="{StaticResource SuccessButtonStyle}"
                                                Padding="8,4"
                                                MinWidth="70"
                                                Command="{Binding DataContext.MarkAsReadyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=2}"/>
                                        <Button Content="Finalizar"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="8,4"
                                                MinWidth="70"
                                                Command="{Binding DataContext.FinalizeOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=3}"/>
                                        <Button Content="Cancelar"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="8,4"
                                                MinWidth="60"
                                                Command="{Binding DataContext.CancelOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=1}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Background="#CCFFFFFF"
                        Panel.ZIndex="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}"
                                             Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True"
                                     Width="180"
                                     Height="5"/>
                        <TextBlock Text="Carregando pedidos..."
                                   Margin="0,12,0,0"
                                   Foreground="#374151"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Ações do pedido selecionado -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="8"
                Padding="12"
                Margin="0,16,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Ações do pedido selecionado:"
                           VerticalAlignment="Center"
                           Foreground="#4B5563"
                           Margin="0,0,12,0"/>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">
                    <Button Content="Ver Detalhes"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ViewOrderCommand}"/>

                    <Button Content="Iniciar Preparação"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartPreparationCommand}"
                            Visibility="{Binding SelectedItem.Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=1}"/>

                    <Button Content="Marcar como Pronto"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding MarkAsReadyCommand}"
                            Visibility="{Binding SelectedItem.Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=2}"/>

                    <Button Content="Finalizar Pedido"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding FinalizeOrderCommand}"
                            Visibility="{Binding SelectedItem.Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=3}"/>

                    <Button Content="Cancelar Pedido"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding CancelOrderCommand}"
                            Visibility="{Binding SelectedItem.Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter=1}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>