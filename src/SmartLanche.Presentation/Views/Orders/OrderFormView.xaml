<UserControl x:Class="SmartLanche.Presentation.Views.Orders.OrderFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters"
             xmlns:viewsOrders="clr-namespace:SmartLanche.Presentation.Views.Orders"
             xmlns:dto="clr-namespace:SmartLanche.Application.DTOs;assembly=SmartLanche.Application"
             Background="#F5F6FA">

    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding RemoveItemCommand}"
                    CommandParameter="{Binding SelectedOrderItem}"/>
        <KeyBinding Key="Escape" Command="{Binding ClearFormCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>
        <converters:BoolToComboConverter x:Key="BoolToComboConverter"/>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>

        <Style x:Key="PickerButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryPickerButtonStyle" TargetType="Button" BasedOn="{StaticResource PickerButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CenterAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
        </Style>

        <Style x:Key="SuccessActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SuccessButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="Novo pedido"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Order.Id, Converter={StaticResource NullToBoolConverter}}"
                                         Value="True">
                                <Setter Property="Text"
                                        Value="Editar pedido"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <TextBlock Text="Adicione itens e gerencie o pedido."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="#6B7280"/>
        </StackPanel>

        <!-- Formulário -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho do pedido: Cliente -->
                <Border Grid.Row="0"
                        Background="#F9FAFB"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Cliente"
                                       Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Customers}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedCustomerId, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource FormComboBoxStyle}"
                                      Width="280"
                                      ToolTip="Selecione o cliente (opcional)."/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="Produto"
                                       Style="{StaticResource FormLabelStyle}"/>
                            <Button Content="{Binding SelectedProduct.Name, FallbackValue='Selecionar Produto', TargetNullValue='Selecionar Produto'}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Width="280"
                                    HorizontalContentAlignment="Left"
                                    Padding="10,8"
                                    Command="{Binding OpenProductPickerCommand}"
                                    ToolTip="Clique para buscar e selecionar produto">
                            <Button.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"
                                            CommandParameter="{Binding SelectedProduct}"/>
                            </Button.InputBindings>
                        </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="0,0,16,0">
                            <TextBlock Text="Quantidade"
                                       Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Width="100"
                                     ToolTip="Informe a quantidade.">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"
                                            CommandParameter="{Binding SelectedProduct}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Margin="0,0,16,0" VerticalAlignment="Bottom">
                            <TextBlock Text=" "
                                       Style="{StaticResource FormLabelStyle}"/>
                            <Button Content="Adicionar"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    MinWidth="90"
                                    Command="{Binding AddItemCommand}"
                                    ToolTip="Adicionar item ao pedido"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Promoções Aplicadas -->
                <Border Grid.Row="1"
                        Background="#FEF3C7"
                        BorderBrush="#FCD34D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,16"
                        Visibility="{Binding AppliedPromotions.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="🎁 Promoções Aplicadas:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#92400E"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding AppliedPromotions}"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="dto:PromotionDto">
                                    <Border Background="#FDE68A"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,8,4"
                                            BorderBrush="#F59E0B"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#92400E"/>
                                            <TextBlock Text=" "
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding DiscountType, Converter={StaticResource EnumToDescriptionConverter}}"
                                                       FontSize="11"
                                                       Foreground="#92400E"/>
                                            <TextBlock Text=" "
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding DiscountValue, StringFormat=N2}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#92400E"/>
                                            <TextBlock Text="{Binding DiscountType, Converter={StaticResource EnumToDescriptionConverter}, ConverterParameter=Suffix}"
                                                       FontSize="11"
                                                       Foreground="#92400E"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Column="2"
                                Content="Recalcular"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RecalculateCommand}"
                                ToolTip="Recalcular total aplicando promoções elegíveis"
                                Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Product Picker with Tabs (Products / Combos) -->
                <Border Grid.Row="2"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16"
                        Visibility="{Binding IsProductPickerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TabControl>
                        <!-- Aba Produtos -->
                        <TabItem Header="📦 Produtos" Padding="16,8">
                            <viewsOrders:ProductPickerView DataContext="{Binding ProductPickerViewModel}"/>
                        </TabItem>

                        <!-- Aba Combos Sugeridos -->
                        <TabItem Header="🎁 Combos Sugeridos" Padding="16,8"
                                 Visibility="{Binding SuggestedCombos.Count, Converter={StaticResource CountToVisibilityConverter}}">
                            <Border Background="White"
                                    BorderBrush="#E5E7EB"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DataGrid Grid.Row="0"
                                              ItemsSource="{Binding SuggestedCombos}"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              SelectionMode="Single"
                                              SelectionUnit="FullRow"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              RowHeaderWidth="0"
                                              BorderThickness="0"
                                              Background="White"
                                              AlternatingRowBackground="#F9FAFB"
                                              MaxHeight="350">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Combo"
                                                                Binding="{Binding Name}"
                                                                Width="3*"/>
                                            <DataGridTextColumn Header="Descrição"
                                                                Binding="{Binding Description}"
                                                                Width="3*"/>
                                            <DataGridTextColumn Header="Preço (R$)"
                                                                Binding="{Binding Price, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                                Width="120"
                                                                ElementStyle="{StaticResource RightAlignStyle}"/>
                                            <DataGridTextColumn Header="Itens"
                                                                Binding="{Binding Items.Count}"
                                                                Width="80"
                                                                ElementStyle="{StaticResource CenterAlignStyle}"/>
                                            <DataGridTemplateColumn Header="Ação"
                                                                    Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Adicionar"
                                                                Style="{StaticResource PrimaryActionButtonStyle}"
                                                                Padding="8,4"
                                                                MinWidth="80"
                                                                Command="{Binding DataContext.AddComboCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Id}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Grid.Row="0"
                                               Text="Nenhum combo disponível."
                                               Foreground="#9CA3AF"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding SuggestedCombos.Count, Converter={StaticResource CountToVisibilityConverter}}"/>

                                    <StackPanel Grid.Row="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,12,0,0">
                                        <Button Content="Fechar"
                                                Style="{StaticResource SecondaryPickerButtonStyle}"
                                                Command="{Binding CloseProductPickerCommand}"
                                                MinWidth="90"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Border>

                <!-- Grid de itens -->
                <Border Grid.Row="3"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,16">

                    <Grid>
                        <DataGrid ItemsSource="{Binding OrderItems}"
                                  SelectedItem="{Binding SelectedOrderItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternatingRowBackground="#F9FAFB">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"
                                            CommandParameter="{Binding SelectedProduct}"/>
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto"
                                                    Binding="{Binding ProductName}"
                                                    Width="3*"/>

                                <DataGridTextColumn Header="Qtd"
                                                    Binding="{Binding Quantity}"
                                                    Width="70"
                                                    ElementStyle="{StaticResource CenterAlignStyle}"/>

                                <DataGridTextColumn Header="Preço Unit. (R$)"
                                                    Binding="{Binding UnitPrice, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                    Width="120"
                                                    ElementStyle="{StaticResource RightAlignStyle}"/>

                                <DataGridTextColumn Header="Subtotal (R$)"
                                                    Binding="{Binding Subtotal, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                    Width="120"
                                                    ElementStyle="{StaticResource RightAlignStyle}"/>

                                <DataGridTemplateColumn Header="Ações"
                                                        Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Button Content="Remover"
                                                        Style="{StaticResource DangerActionButtonStyle}"
                                                        Padding="6,3"
                                                        MinWidth="60"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Nenhum item adicionado."
                                   Foreground="#9CA3AF"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding OrderItems.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Pagamento -->
                <Border Grid.Row="4"
                        Background="#F0F9FF"
                        BorderBrush="#0EA5E9"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16"
                        Visibility="{Binding CanAddItems, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Pagamento"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#0369A1"
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Forma de Pagamento -->
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Forma de Pagamento"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding FormasPagamento}"
                                          SelectedItem="{Binding SelectedFormaPagamento, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          Width="180">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Valor Pago -->
                            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                <TextBlock Text="Valor Pago (R$)"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding ValorPago, UpdateSourceTrigger=PropertyChanged, StringFormat='C2', ConverterCulture='pt-BR'}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Width="150"
                                         ToolTip="Informe o valor recebido">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding CloseWithPaymentCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>

                            <!-- Parcelas (visível para Cartão) -->
                            <StackPanel Grid.Column="2" Margin="0,0,16,0"
                                        Visibility="{Binding ShowParcelas, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Parcelas"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding Parcelas, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Width="80"
                                         ToolTip="Número de parcelas (1-12)">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding CloseWithPaymentCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </StackPanel>

                            <!-- Troco (visível para Dinheiro) -->
                            <StackPanel Grid.Column="3" Margin="0,0,16,0"
                                        Visibility="{Binding ShowTroco, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Troco (R$)"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding Troco, StringFormat='C2', ConverterCulture='pt-BR', FallbackValue='R$ 0,00'}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#166534"
                                           VerticalAlignment="Center"
                                           Margin="10,8,0,0"/>
                            </StackPanel>

                            <!-- Cliente (visível para Fiado) -->
                            <StackPanel Grid.Column="4" Margin="0,0,16,0"
                                        Visibility="{Binding ShowCustomerSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Cliente (Obrigatório para Fiado)"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Customers}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedCustomerId, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource FormComboBoxStyle}"
                                          Width="220"
                                          ToolTip="Selecione o cliente para pagamento a prazo"/>
                            </StackPanel>

                            <!-- Valor Parcela -->
                            <StackPanel Grid.Column="5" Margin="0,0,0,0"
                                        Visibility="{Binding ShowParcelas, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Valor Parcela (R$)"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock Text="{Binding ValorParcela, StringFormat='C2', ConverterCulture='pt-BR', FallbackValue='R$ 0,00'}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#0369A1"
                                           VerticalAlignment="Center"
                                           Margin="10,8,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Observações de Pagamento -->
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Observações"
                                       Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding PaymentObservacoes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource FormTextBoxStyle}"
                                     Height="60"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     ToolTip="Observações sobre o pagamento (opcional)"/>
                        </StackPanel>

                        <!-- Botão Fechar com Pagamento -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Fechar com Pagamento"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Command="{Binding CloseWithPaymentCommand}"
                                    MinWidth="160"
                                    Padding="16,10"
                                    FontSize="14"
                                    FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Total e ações -->
                <Border Grid.Row="5"
                        Background="#F9FAFB"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total: "
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat='C2', ConverterCulture='pt-BR'}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#166534"/>
                            <TextBlock Text="  |  "
                                       FontSize="18"
                                       Foreground="#6B7280"/>
                            <TextBlock Text="{Binding Status}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Fechar Pedido"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Command="{Binding CloseOrderCommand}"
                                    Visibility="{Binding CanAddItems, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Button Content="Cancelar Pedido"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding CancelOrderCommand}"
                                    Visibility="{Binding CanAddItems, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>