<UserControl x:Class="SmartLanche.Presentation.Views.Orders.OrderFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters"
             xmlns:viewsOrders="clr-namespace:SmartLanche.Presentation.Views.Orders"
             xmlns:dto="clr-namespace:SmartLanche.Application.DTOs;assembly=SmartLanche.Application"
             Background="#F5F6FA">

    <UserControl.InputBindings>
        <KeyBinding Key="Delete" Command="{Binding RemoveItemCommand}"
                    CommandParameter="{Binding SelectedOrderItem}"/>
        <KeyBinding Key="Escape" Command="{Binding ClearFormCommand}"/>
    </UserControl.InputBindings>

    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter"/>
        <converters:BoolToComboConverter x:Key="BoolToComboConverter"/>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <converters:StringIsNullOrEmptyToVisibilityConverter x:Key="StringIsNullOrEmptyToVisibilityConverter"/>

        <Style x:Key="PickerButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryPickerButtonStyle" TargetType="Button" BasedOn="{StaticResource PickerButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CenterAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ActionButtonStyle"
               TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="PrimaryActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
        </Style>

        <Style x:Key="SuccessActionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SuccessButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="110"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="90"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#111827">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Novo pedido"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Order.Id, Converter={StaticResource NullToBoolConverter}}"
                                                 Value="True">
                                        <Setter Property="Text"
                                                Value="Editar pedido"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="Adicione itens e gerencie o pedido."
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="#6B7280"/>
                </StackPanel>

                <!-- Status Workflow Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,8">
                    <Button Content="Iniciar Preparação"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding StartPreparationCommand}"
                            Visibility="{Binding CanStartPreparation, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Iniciar preparação do pedido (Aberto → Em Preparo)"/>
                    <Button Content="Marcar como Pronto"
                            Style="{StaticResource SuccessButtonStyle}"
                            Command="{Binding MarkAsReadyCommand}"
                            Visibility="{Binding CanMarkAsReady, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Marcar pedido como pronto (Em Preparo → Pronto)"/>
                    <Button Content="Cancelar Pedido"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding CancelOrderCommand}"
                            Visibility="{Binding CanCancelOrder, Converter={StaticResource BoolToVisibilityConverter}}"
                            ToolTip="Cancelar pedido"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Formulário -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="24">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho do pedido: Produtos -->
                <Border Grid.Row="0"
                        Background="#F9FAFB"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Border Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>  <!-- Cliente search -->
                                    <RowDefinition Height="Auto"/>  <!-- Observações -->
                                    <RowDefinition Height="Auto"/>  <!-- Categoria -->
                                    <RowDefinition Height="*"/>     <!-- Produtos -->
                                </Grid.RowDefinitions>

                                <!-- Pesquisa de Cliente -->
                                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="Cliente:" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,6"/>

                                    <!-- Campo de busca com ícone de lupa -->
                                    <TextBox Height="38"
                                             HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300, Mode=TwoWay}"
                                             BorderBrush="#D1D5DB" BorderThickness="1"
                                             ToolTip="Digite nome, telefone ou observações para buscar cliente">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="Border" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Foreground="#94A3B8" Margin="8,0,8,0"
                                                                   Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}}"/>
                                                        <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Margin="0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>

                                    <!-- Resultados da busca -->
                                    <ListBox ItemsSource="{Binding FilteredCustomers}"
                                             SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                             BorderBrush="#D1D5DB"
                                             BorderThickness="1"
                                             Background="White"
                                             MaxHeight="200"
                                             Margin="0,4,0,0"
                                             Visibility="{Binding ShowCustomerSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           Padding="12,8"
                                                           Foreground="#1F2937"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>

                                <!-- Observações -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <TextBlock Text="Observações:" Style="{StaticResource FormLabelStyle}" Margin="0,0,0,6"/>
                                    <TextBox Height="80"
                                             HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Top"
                                             Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             BorderBrush="#D1D5DB" BorderThickness="1"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             ToolTip="Observações do pedido (opcional)"/>
                                </StackPanel>

                                <!-- Filtro de categoria -->
                                <StackPanel Grid.Row="2"
                                            Orientation="Horizontal"
                                            Margin="0,0,0,12">
                                    <TextBlock Text="Categoria:"
                                               Style="{StaticResource FormLabelStyle}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,12,0"/>
                                    <ComboBox ItemsSource="{Binding Categories}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding SelectedCategoryId, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              Width="200"
                                              ToolTip="Filtrar produtos por categoria"/>
                                </StackPanel>

                                <!-- Grid de produtos filtrados -->
                                <DataGrid Grid.Row="3"
                                          ItemsSource="{Binding FilteredProducts}"
                                          SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          SelectionMode="Single"
                                          SelectionUnit="FullRow"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeaderWidth="0"
                                          BorderThickness="0"
                                          Background="White"
                                          AlternatingRowBackground="#F9FAFB"
                                          MaxHeight="200">
                                    <DataGrid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding AddItemCommand}"
                                                      CommandParameter="{Binding SelectedProduct}"/>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding AddItemCommand}"
                                                    CommandParameter="{Binding SelectedProduct}"/>
                                    </DataGrid.InputBindings>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Produto"
                                                            Binding="{Binding Name}"
                                                            Width="3*"/>
                                        <DataGridTextColumn Header="Categoria"
                                                            Binding="{Binding CategoryName}"
                                                            Width="2*"/>
                                        <DataGridTextColumn Header="Preço (R$)"
                                                            Binding="{Binding Price, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                            Width="120"
                                                            ElementStyle="{StaticResource RightAlignStyle}"/>

                                        <!-- Quantidade com botões +/- -->
                                        <DataGridTemplateColumn Header="Qtd"
                                                                Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="White"
                                                            BorderBrush="#D1D5DB"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="2">
                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <Button Content="−"
                                                                    Width="28"
                                                                    Height="28"
                                                                    FontSize="16"
                                                                    FontWeight="Bold"
                                                                    Foreground="#374151"
                                                                    Background="#F3F4F6"
                                                                    BorderBrush="#D1D5DB"
                                                                    BorderThickness="1,1,0,1"
                                                                    Padding="0"
                                                                    Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Diminuir quantidade"/>
                                                            <TextBlock Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                       Width="40"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#1F2937"/>
                                                            <Button Content="+"
                                                                    Width="28"
                                                                    Height="28"
                                                                    FontSize="14"
                                                                    FontWeight="Bold"
                                                                    Foreground="#374151"
                                                                    Background="#F3F4F6"
                                                                    BorderBrush="#D1D5DB"
                                                                    BorderThickness="0,1,1,1"
                                                                    Padding="0"
                                                                    Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Aumentar quantidade"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <!-- Botão Adicionar -->
                                        <DataGridTemplateColumn Header="Ação"
                                                                Width="90">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Adicionar"
                                                            Style="{StaticResource PrimaryActionButtonStyle}"
                                                            Padding="6,3"
                                                            MinWidth="70"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Command="{Binding DataContext.AddItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                </Border>

                <!-- Promoções Aplicadas -->
                <Border Grid.Row="1"
                        Background="#FEF3C7"
                        BorderBrush="#FCD34D"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12"
                        Margin="0,0,0,16"
                        Visibility="{Binding AppliedPromotions.Count, Converter={StaticResource CountToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="🎁 Promoções Aplicadas:"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#92400E"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding AppliedPromotions}"
                                      HorizontalAlignment="Left">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="dto:PromotionDto">
                                    <Border Background="#FDE68A"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,8,4"
                                            BorderBrush="#F59E0B"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#92400E"/>
                                            <TextBlock Text=" "
                                                       FontSize="12"/>
                                            <TextBlock Text="{Binding DiscountType, Converter={StaticResource EnumToDescriptionConverter}}"
                                                       FontSize="11"
                                                       Foreground="#92400E"/>
                                            <TextBlock Text=" "
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding DiscountValue, StringFormat=N2}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#92400E"/>
                                            <TextBlock Text="{Binding DiscountType, Converter={StaticResource EnumToDescriptionConverter}, ConverterParameter=Suffix}"
                                                       FontSize="11"
                                                       Foreground="#92400E"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Column="2"
                                Content="Recalcular"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RecalculateCommand}"
                                ToolTip="Recalcular total aplicando promoções elegíveis"
                                Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Grid de itens -->
                <Border Grid.Row="2"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,16">

                    <Grid>
                        <DataGrid ItemsSource="{Binding OrderItems}"
                                  SelectedItem="{Binding SelectedOrderItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  SelectionMode="Single"
                                  SelectionUnit="FullRow"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  RowHeaderWidth="0"
                                  BorderThickness="0"
                                  Background="White"
                                  AlternatingRowBackground="#F9FAFB">
                            <DataGrid.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding AddItemCommand}"
                                            CommandParameter="{Binding SelectedProduct}"/>
                            </DataGrid.InputBindings>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Produto"
                                                    Binding="{Binding ProductName}"
                                                    Width="4*"/>

                                <DataGridTextColumn Header="Qtd"
                                                    Binding="{Binding Quantity}"
                                                    Width="70"
                                                    ElementStyle="{StaticResource CenterAlignStyle}"/>

                                <DataGridTextColumn Header="Preço Unit. (R$)"
                                                    Binding="{Binding UnitPrice, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                    Width="150"
                                                    ElementStyle="{StaticResource RightAlignStyle}"/>

                                <DataGridTextColumn Header="Subtotal (R$)"
                                                    Binding="{Binding Subtotal, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                    Width="150"
                                                    ElementStyle="{StaticResource RightAlignStyle}"/>

                                <DataGridTemplateColumn Header="Ações"
                                                        Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center">
                                                <Button Content="Remover"
                                                        Style="{StaticResource DangerActionButtonStyle}"
                                                        Padding="6,3"
                                                        MinWidth="60"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="Nenhum item adicionado."
                                   Foreground="#9CA3AF"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding OrderItems.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                    </Grid>
                </Border>

                <!-- Total e status -->
                <Border Grid.Row="3"
                        Background="#F9FAFB"
                        CornerRadius="6"
                        Padding="16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Total: "
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalAmount, StringFormat='C2', ConverterCulture='pt-BR'}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#166534"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="  |  "
                                       FontSize="18"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Status}"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Cancelar Pedido"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding CancelOrderCommand}"
                                    Visibility="{Binding CanCancelOrder, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>