<UserControl x:Class="SmartLanche.Presentation.Views.Orders.OrderCloseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:SmartLanche.Presentation.Behaviors"
             xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters"
             xmlns:domain="clr-namespace:SmartLanche.Domain.Enums;assembly=SmartLanche.Domain"
             Background="#F5F6FA">

    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StringIsNullOrEmptyToVisibilityConverter x:Key="StringIsNullOrEmptyToVisibilityConverter"/>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,8,4"/>
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CenterAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#FEE2E2"/>
            <Setter Property="Foreground" Value="#991B1B"/>
        </Style>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="#111827"
                       Text="Finalizar Pedido"/>
            <TextBlock FontSize="13" Foreground="#6B7280"
                       Text="{Binding Order.Status, Converter={StaticResource EnumToDescriptionConverter}, ConverterParameter=StatusDescription}"/>
        </StackPanel>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White" CornerRadius="8" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header do pedido -->
                    <Border Grid.Row="0" Background="#F9FAFB" CornerRadius="6" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Código" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Order.Id, StringFormat='#{0}'}"
                                           Style="{StaticResource DetailValueStyle}" FontSize="18" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,16,0">
                                <TextBlock Text="Data" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Order.OrderDate, StringFormat='dd/MM/yyyy HH:mm'}"
                                           Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Margin="0,0,16,0">
                                <TextBlock Text="Cliente" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Order.CustomerName, FallbackValue='Não informado'}"
                                           Style="{StaticResource DetailValueStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="5">
                                <TextBlock Text="Status" Style="{StaticResource DetailLabelStyle}"/>
                                <TextBlock Text="{Binding Order.Status}"
                                           FontSize="14" FontWeight="SemiBold"
                                           Foreground="{Binding Order.Status, Converter={StaticResource StatusToColorConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Observações -->
                    <Border Grid.Row="1" Background="#F9FAFB" CornerRadius="6" Padding="16" Margin="0,0,0,16"
                            Visibility="{Binding Order.Notes, Converter={StaticResource NullToBoolConverter}, ConverterParameter=reverse}">
                        <StackPanel>
                            <TextBlock Text="Observações" Style="{StaticResource DetailLabelStyle}"/>
                            <TextBlock Text="{Binding Order.Notes}" Style="{StaticResource DetailValueStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Itens do pedido -->
                    <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                        <Grid>
                            <DataGrid ItemsSource="{Binding Order.Items}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0"
                                      BorderThickness="0"
                                      Background="White"
                                      AlternatingRowBackground="#F9FAFB">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Produto"
                                                        Binding="{Binding ProductName}"
                                                        Width="3*"/>

                                    <DataGridTextColumn Header="Qtd"
                                                        Binding="{Binding Quantity}"
                                                        Width="70"
                                                        ElementStyle="{StaticResource CenterAlignStyle}"/>

                                    <DataGridTextColumn Header="Preço Unit. (R$)"
                                                        Binding="{Binding UnitPrice, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                        Width="130"
                                                        ElementStyle="{StaticResource RightAlignStyle}"/>

                                    <DataGridTextColumn Header="Subtotal (R$)"
                                                        Binding="{Binding Subtotal, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                        Width="130"
                                                        ElementStyle="{StaticResource RightAlignStyle}"/>
                                </DataGrid.Columns>

                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F0F9FF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                            </DataGrid>

                            <TextBlock Text="Nenhum item neste pedido."
                                       Foreground="#9CA3AF"
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Order.Items.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=reverse}"/>
                        </Grid>
                    </Border>

                    <!-- Seção de Pagamento -->
                    <Border Grid.Row="3"
                            Background="#F0F9FF"
                            BorderBrush="#0EA5E9"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,0,16">

                        <StackPanel>
                            <TextBlock Text="Informações de Pagamento"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="#0369A1"
                                       Margin="0,0,0,12"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Forma de Pagamento -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Text="Forma de Pagamento"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <ComboBox ItemsSource="{Binding FormasPagamento}"
                                              SelectedItem="{Binding SelectedFormaPagamento, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource FormComboBoxStyle}"
                                              Width="180">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Valor Pago -->
                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="Valor Pago (R$)"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox ToolTip="Informe o valor recebido"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             HorizontalAlignment="Left"
                                             Width="150">
                                        <i:Interaction.Behaviors>
                                            <behaviors:CurrencyTextBoxBehavior Value="{Binding ValorPago, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </i:Interaction.Behaviors>
                                    </TextBox>
                                </StackPanel>

                                <!-- Parcelas (visível para Cartão) -->
                                <StackPanel Grid.Column="2" Margin="0,0,16,0"
                                            Visibility="{Binding ShowParcelas, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Parcelas"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBox Text="{Binding Parcelas, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Width="80"
                                             ToolTip="Número de parcelas (1-12)"/>
                                </StackPanel>

                                <!-- Troco (visível para Dinheiro) -->
                                <StackPanel Grid.Column="3" Margin="0,0,16,0"
                                            Visibility="{Binding ShowTroco, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Troco (R$)"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBlock Text="{Binding Troco, StringFormat='C2', ConverterCulture='pt-BR', FallbackValue='R$ 0,00'}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#166534"
                                               VerticalAlignment="Center"
                                               Margin="10,8,0,0"/>
                                </StackPanel>

                                <!-- Cliente (visível para Fiado) -->
                                <StackPanel Grid.Column="4" Margin="0,0,16,0"
                                            Visibility="{Binding ShowCustomerSelection, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Cliente (Obrigatório para Fiado)"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    
                                    <!-- Campo de busca com ícone de lupa -->
                                    <TextBox Height="38"
                                             HorizontalAlignment="Stretch"
                                             VerticalContentAlignment="Center"
                                             Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300, Mode=TwoWay}"
                                             BorderBrush="#D1D5DB" BorderThickness="1"
                                             ToolTip="Digite nome, telefone ou observações para buscar cliente">
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border x:Name="Border" Background="White" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Foreground="#94A3B8" Margin="8,0,8,0"
                                                                   Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}}"/>
                                                        <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center" Margin="0"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="#2563EB"/>
                                                        <Setter TargetName="Border" Property="BorderThickness" Value="2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>

                                    <!-- Resultados da busca -->
                                    <ListBox ItemsSource="{Binding FilteredCustomers}"
                                             SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                             BorderBrush="#D1D5DB"
                                             BorderThickness="1"
                                             Background="White"
                                             MaxHeight="200"
                                             Margin="0,4,0,0"
                                             Visibility="{Binding ShowCustomerSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           Padding="12,8"
                                                           Foreground="#1F2937" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>

                                    </ListBox>
                                </StackPanel>

                                <!-- Valor Parcela -->
                                <StackPanel Grid.Column="5" Margin="0,0,0,0"
                                            Visibility="{Binding ShowParcelas, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="Valor Parcela (R$)"
                                               Style="{StaticResource FormLabelStyle}"/>
                                    <TextBlock Text="{Binding ValorParcela, StringFormat='C2', ConverterCulture='pt-BR', FallbackValue='R$ 0,00'}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0369A1"
                                               VerticalAlignment="Center"
                                               Margin="10,8,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Observações de Pagamento -->
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock Text="Observações"
                                           Style="{StaticResource FormLabelStyle}"/>
                                <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Height="60"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         ToolTip="Observações sobre o pagamento (opcional)"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Total -->
                    <Border Grid.Row="4" Background="#F9FAFB" CornerRadius="6" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Total: "
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Order.TotalAmount, StringFormat='C2', ConverterCulture='pt-BR'}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#166534"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="  |  "
                                           FontSize="18"
                                           Foreground="#6B7280"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Order.Status}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding Order.Status, Converter={StaticResource StatusToColorConverter}}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Fechar Pedido"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Command="{Binding CloseOrderCommand}"
                                        Visibility="{Binding CanCloseOrder, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <Button Content="Cancelar Pedido"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Command="{Binding CancelOrderCommand}"
                                        Visibility="{Binding CanCancelOrder, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </ScrollViewer>

        <!-- Botão Voltar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Voltar"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>