<Window x:Class="SmartLanche.Presentation.Views.Payments.RegisterPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters"
        Title="Registrar Pagamento"
        Width="420"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6FA">

    <Window.Resources>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>

        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DialogValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DialogHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="DialogInputStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" Margin="16" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Info -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{Binding PendingPayment.CustomerName, StringFormat='Cliente: {0}'}" Style="{StaticResource DialogHeaderStyle}"/>
                <TextBlock Text="{Binding PendingPayment.OrderId, StringFormat='Pedido: #{0}'}" Style="{StaticResource DialogValueStyle}"/>
                <TextBlock Text="{Binding PendingPayment.ValorOriginal, StringFormat='Valor Original: R$ {0:N2}'}" Style="{StaticResource DialogValueStyle}"/>
                <TextBlock Text="{Binding PendingPayment.ValorPago, StringFormat='Valor Pago: R$ {0:N2}'}" Style="{StaticResource DialogValueStyle}"/>
                <TextBlock Text="{Binding PendingPayment.SaldoPendente, StringFormat='Saldo Pendente: R$ {0:N2}'}"
                           Style="{StaticResource DialogHeaderStyle}"
                           Foreground="#DC2626"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Valor do Pagamento -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <TextBlock Text="Valor do Pagamento:" Style="{StaticResource DialogLabelStyle}"/>
                <TextBox Text="{Binding ValorPagamento, UpdateSourceTrigger=PropertyChanged, Delay=100}"
                         Style="{StaticResource DialogInputStyle}"
                         ToolTip="Informe o valor do pagamento"/>
            </StackPanel>

            <!-- Forma de Pagamento -->
            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock Text="Forma de Pagamento:" Style="{StaticResource DialogLabelStyle}"/>
                <ComboBox ItemsSource="{Binding FormasPagamento}"
                          SelectedItem="{Binding SelectedFormaPagamento, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DialogComboBoxStyle}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- Observações -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="Observações:" Style="{StaticResource DialogLabelStyle}"/>
                <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DialogInputStyle}"
                         Height="70"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Observações sobre o pagamento (opcional)"/>
            </StackPanel>

            <!-- Validação -->
            <TextBlock Grid.Row="4"
                       Text="{Binding ValidationError}"
                       Foreground="#DC2626"
                       FontSize="12"
                       Margin="0,0,0,8"
                       Visibility="{Binding ValidationError, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}, ConverterParameter=reverse}"/>

            <!-- Espaçador -->
            <Grid Grid.Row="5"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancelar"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        IsCancel="True"/>
                <Button Content="Confirmar"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ConfirmCommand}"
                        IsDefault="True"
                        Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>