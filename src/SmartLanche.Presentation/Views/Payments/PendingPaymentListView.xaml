<UserControl x:Class="SmartLanche.Presentation.Views.Payments.PendingPaymentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters"
             xmlns:dto="clr-namespace:SmartLanche.Application.DTOs;assembly=SmartLanche.Application"
             xmlns:domain="clr-namespace:SmartLanche.Domain.Enums;assembly=SmartLanche.Domain"
             Background="#F5F6FA">

    <UserControl.Resources>
        <converters:NullToBoolConverter x:Key="NullToBoolConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <converters:StatusPagamentoToColorConverter x:Key="StatusPagamentoToColorConverter"/>
        <converters:StatusPagamentoToVisibilityConverter x:Key="StatusPagamentoToVisibilityConverter"/>

        <Style x:Key="CenterAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormLabelStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormComboBoxStyle"
               TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0"
                    Margin="0,0,0,20">
            <TextBlock Text="Pendências (Fiado)"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>

            <TextBlock Text="Gerencie pagamentos pendentes de clientes."
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="#6B7280"/>
        </StackPanel>

        <!-- Filtros -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Buscar"
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Width="250"
                             ToolTip="Buscar por cliente ou observações">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Status"
                               Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatus, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource FormComboBoxStyle}"
                              Width="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Cliente"
                               Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding Customers}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedCustomerId, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource FormComboBoxStyle}"
                              Width="220"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text=" "
                               Style="{StaticResource FormLabelStyle}"/>
                    <Button Content="Filtrar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoadCommand}"
                            MinWidth="100"/>
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <TextBlock Text=" "
                               Style="{StaticResource FormLabelStyle}"/>
                    <Button Content="Atualizar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            MinWidth="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid de pendências -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>
                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          Background="White"
                          AlternatingRowBackground="#F9FAFB">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="60"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>

                        <DataGridTextColumn Header="Cliente"
                                            Binding="{Binding CustomerName}"
                                            Width="2*"/>

                        <DataGridTextColumn Header="Pedido"
                                            Binding="{Binding OrderId}"
                                            Width="80"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>

                        <DataGridTextColumn Header="Valor Original (R$)"
                                            Binding="{Binding ValorOriginal, StringFormat='N2'}"
                                            Width="130"
                                            ElementStyle="{StaticResource RightAlignStyle}"/>

                        <DataGridTextColumn Header="Valor Pago (R$)"
                                            Binding="{Binding ValorPago, StringFormat='N2'}"
                                            Width="120"
                                            ElementStyle="{StaticResource RightAlignStyle}"/>

                        <DataGridTextColumn Header="Saldo (R$)"
                                            Binding="{Binding SaldoPendente, StringFormat='N2'}"
                                            Width="120"
                                            ElementStyle="{StaticResource RightAlignStyle}"/>

                        <DataGridTextColumn Header="Data"
                                            Binding="{Binding DataHora, StringFormat='dd/MM/yyyy HH:mm'}"
                                            Width="130"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>

                        <DataGridTemplateColumn Header="Status"
                                                Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusPagamento, Converter={StaticResource EnumToDescriptionConverter}}"
                                               Foreground="{Binding StatusPagamento, Converter={StaticResource StatusPagamentoToColorConverter}}"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ações"
                                                Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Registrar Pagamento"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Padding="6,3"
                                            MinWidth="100"
                                            Visibility="{Binding StatusPagamento, Converter={StaticResource StatusPagamentoToVisibilityConverter}, ConverterParameter=NaoPago}"
                                            Command="{Binding DataContext.RegisterPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Histórico"
                                                Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Ver Histórico"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Padding="6,3"
                                            MinWidth="90"
                                            Command="{Binding DataContext.OpenHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Nenhuma pendência encontrada."
                           Foreground="#9CA3AF"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding PendingPayments.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>