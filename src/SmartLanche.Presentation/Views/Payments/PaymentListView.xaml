<UserControl x:Class="SmartLanche.Presentation.Views.Payments.PaymentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:SmartLanche.Presentation.Converters"
             xmlns:paymentVm="clr-namespace:SmartLanche.Presentation.ViewModels.Payments"
             Background="#F5F6FA">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FormDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="CenterAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="RightAlignStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Pagamentos"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="#111827"/>
            <TextBlock Text="Histórico de pagamentos recebidos"
                       Margin="0,6,0,0"
                       FontSize="13"
                       Foreground="#6B7280"/>
        </StackPanel>

        <!-- Filtros -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="16"
                Margin="0,0,0,16"
                BorderBrush="#E5E7EB"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Busca -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Buscar"
                               Style="{StaticResource FormLabelStyle}"/>
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                             Style="{StaticResource FormTextBoxStyle}"
                             Width="250"
                             ToolTip="Buscar por ID do pedido, observações">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding LoadCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </StackPanel>

                <!-- Forma de Pagamento -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Forma de Pagamento"
                               Style="{StaticResource FormLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding FormasPagamento}"
                              SelectedItem="{Binding SelectedFormaPagamento, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource FormComboBoxStyle}"
                              Width="180">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Data Início -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="Data Início"
                               Style="{StaticResource FormLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding StartDate, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormDatePickerStyle}"
                                Width="150"/>
                </StackPanel>

                <!-- Data Fim -->
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="0,0,16,0">
                    <TextBlock Text="Data Fim"
                               Style="{StaticResource FormLabelStyle}"/>
                    <DatePicker SelectedDate="{Binding EndDate, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource FormDatePickerStyle}"
                                Width="150"/>
                </StackPanel>

                <!-- Botões de ação -->
                <StackPanel Grid.Row="0" Grid.Column="4" VerticalAlignment="Bottom" Margin="0,0,8,0">
                    <Button Content="Filtrar"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding LoadCommand}"
                            MinWidth="90"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="5" VerticalAlignment="Bottom" Margin="0,0,8,0">
                    <Button Content="Limpar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding RefreshCommand}"
                            MinWidth="90"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid de pagamentos -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">

            <Grid>
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          Background="White"
                          AlternatingRowBackground="#F9FAFB"
                          IsEnabled="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=reverse}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding Id}"
                                            Width="60"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>

                        <DataGridTextColumn Header="Pedido"
                                            Binding="{Binding OrderId, StringFormat='#{0}'}"
                                            Width="80"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>

                        <DataGridTemplateColumn Header="Forma"
                                                Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FormaPagamento, Converter={StaticResource EnumToDescriptionConverter}}"
                                               VerticalAlignment="Center"
                                               Margin="8,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Valor Pago (R$)"
                                            Binding="{Binding ValorPago, StringFormat='N2'}"
                                            Width="120"
                                            ElementStyle="{StaticResource RightAlignStyle}"/>

                        <DataGridTextColumn Header="Troco (R$)"
                                            Binding="{Binding Troco, StringFormat='N2'}"
                                            Width="100"
                                            ElementStyle="{StaticResource RightAlignStyle}"/>

                        <DataGridTextColumn Header="Parcelas"
                                            Binding="{Binding Parcelas}"
                                            Width="80"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>

                        <DataGridTextColumn Header="Valor Parcela (R$)"
                                            Binding="{Binding ValorParcela, StringFormat='N2'}"
                                            Width="120"
                                            ElementStyle="{StaticResource RightAlignStyle}"/>

                        <DataGridTextColumn Header="Data/Hora"
                                            Binding="{Binding DataHora, StringFormat='dd/MM/yyyy HH:mm'}"
                                            Width="140"
                                            ElementStyle="{StaticResource CenterAlignStyle}"/>

                        <DataGridTextColumn Header="Observações"
                                            Binding="{Binding Observacoes}"
                                            Width="*"/>

                        <DataGridTemplateColumn Header="Estornado"
                                                Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Estornado, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Sim;Não}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{Binding Estornado, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=#DC2626;#166534}"
                                               FontWeight="SemiBold"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Ações"
                                                Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="Ver"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                Padding="8,4"
                                                MinWidth="60"
                                                FontSize="11"
                                                Command="{Binding DataContext.ViewPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Ver detalhes"/>
                                        <Button Content="Estornar"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="8,4"
                                                MinWidth="70"
                                                FontSize="11"
                                                Margin="4,0,0,0"
                                                Command="{Binding DataContext.EstornarPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Estornar pagamento"
                                                Visibility="{Binding Estornado, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Collapsed;Visible}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Text="Nenhum pagamento encontrado."
                           Foreground="#9CA3AF"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding Payments.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
            </Grid>
        </Border>

        <!-- Resumo -->
        <Border Grid.Row="3"
                Background="#F0F9FF"
                BorderBrush="#0EA5E9"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Total Recebido: "
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0369A1"/>
                    <TextBlock Text="{Binding TotalRecebidoFormatted}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#0369A1"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="{Binding TotalPaymentsCount, StringFormat='{} | {0} pagamento(s)'}"
                           FontSize="14"
                           Foreground="#0369A1"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>