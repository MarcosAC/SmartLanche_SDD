<UserControl x:Class="SmartLanche.Presentation.Views.Combos.ComboFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartLanche.Presentation.Converters"
             Background="#F5F6FA">

    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <local:NullToBoolConverter x:Key="NullToBoolConverter"/>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldControlStyle"
               TargetType="Control">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="Foreground" Value="#1F2937"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="#F9FAFB"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" Margin="8,4"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboItemRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsValid}" Value="False">
                    <Setter Property="Background" Value="#FEF2F2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"
                                    Value="Novo combo"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}"
                                             Value="True">
                                    <Setter Property="Text"
                                            Value="Editar combo"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Preencha os dados do combo e adicione os itens componentes."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Formulário Principal -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,0,0,16">

                <StackPanel>
                    <!-- Nome -->
                    <TextBlock Text="Nome *"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Text="{Binding Name,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="150"
                             ToolTip="Informe o nome do combo"
                             Style="{StaticResource FieldControlStyle}"/>

                    <!-- Descrição -->
                    <TextBlock Text="Descrição"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Text="{Binding Description,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500"
                             MinHeight="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             ToolTip="Descrição opcional do combo"
                             Style="{StaticResource FieldControlStyle}"/>

                    <!-- Preço do Combo -->
                    <TextBlock Text="Preço do Combo *"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Text="{Binding Price,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            StringFormat=C2, ConverterCulture='pt-BR'}"
                             ToolTip="Preço especial do combo (deve ser menor que a soma dos itens)"
                             Style="{StaticResource FieldControlStyle}"/>

                    <TextBlock Text="O preço do combo deve ser atrativo em relação à soma dos itens individuais."
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,-10,0,16"/>

                    <!-- Itens do Combo -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Itens do Combo (mínimo 2 itens) *"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <Button Grid.Column="1"
                                Content="+ Adicionar Item"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddItemCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,0,8"/>
                    </Grid>

                    <!-- DataGrid de Itens -->
                    <Border BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="0,0,0,16"
                            MinHeight="200"
                            MaxHeight="350">
                        <DataGrid ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E7EB"
                                  RowHeaderWidth="0"
                                  Background="White"
                                  AlternatingRowBackground="#F9FAFB"
                                  ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                  CellStyle="{StaticResource DataGridCellStyle}"
                                  RowStyle="{StaticResource ComboItemRowStyle}">

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Produto *" Width="3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProductName}"
                                                       VerticalAlignment="Center"
                                                       Margin="8,4"
                                                       Foreground="{Binding ProductId, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Invert, FallbackValue=#DC2626, TargetNullValue=#1F2937}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      SelectedValue="{Binding ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEditable="False"
                                                      Margin="4,2"
                                                      VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Quantidade *"
                                                    Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Preço Unit."
                                                    Binding="{Binding ProductPrice, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                    Width="120"
                                                    IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Subtotal"
                                                        Width="120"
                                                        IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Subtotal, StringFormat='C2', ConverterCulture='pt-BR'}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Foreground="#1F2937"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="Ações"
                                                        Width="100"
                                                        IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Remover"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,4"
                                                    FontSize="12"
                                                    MinWidth="70"
                                                    MinHeight="32"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Validação de itens mínimos -->
                    <TextBlock Text="⚠ Mínimo de 2 itens necessários para salvar o combo."
                               FontSize="12"
                               Foreground="#DC2626"
                               FontWeight="Medium"
                               Margin="0,0,0,16"
                               Visibility="{Binding HasMinimumItems, Converter={StaticResource NullToBoolConverter}, ConverterParameter=Invert}"/>

                    <!-- Total dos itens vs Preço do combo -->
                    <Border Background="#F0FDF4"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Soma dos itens: "
                                       FontSize="13"
                                       Foreground="#374151"/>
                            <TextBlock Text="{Binding ItemsTotal, StringFormat='C2', ConverterCulture='pt-BR'}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#166534"/>
                            <TextBlock Text="    |    Preço do combo: "
                                       FontSize="13"
                                       Foreground="#374151"
                                       Margin="16,0,0,0"/>
                            <TextBlock Text="{Binding Price, StringFormat='C2', ConverterCulture='pt-BR'}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#15803D"/>
                            <TextBlock Text="    |    Desconto: "
                                       FontSize="13"
                                       Foreground="#374151"
                                       Margin="16,0,0,0"/>
                            <TextBlock Text="{Binding DiscountAmount, StringFormat='C2', ConverterCulture='pt-BR'}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>

                    <!-- Carregando produtos -->
                    <Border Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsLoadingProducts, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Carregando produtos..."
                                   Foreground="#1D4ED8"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Status: somente leitura -->
                    <TextBlock Text="Status"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock Margin="0,0,0,20"
                               FontSize="14"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Ativo"/>
                                <Setter Property="Foreground" Value="#15803D"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}"
                                                 Value="False">
                                        <Setter Property="Text" Value="Inativo"/>
                                        <Setter Property="Foreground"
                                                Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="O status do combo é gerenciado pela listagem."
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,0,0,8"/>
                </StackPanel>
            </Border>

            <!-- Ação -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Cadastrar"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="Salvar alterações"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSaving}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="Salvando..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>