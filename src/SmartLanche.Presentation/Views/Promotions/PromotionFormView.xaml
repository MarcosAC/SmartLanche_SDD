<UserControl x:Class="SmartLanche.Presentation.Views.Promotions.PromotionFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartLanche.Presentation.Converters"
             Background="#F5F6FA">

    <UserControl.Resources>
        <local:EnumToDescriptionConverter x:Key="EnumToDescriptionConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style x:Key="FieldLabelStyle"
               TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldControlStyle"
               TargetType="Control">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0"
                        Margin="0,0,0,20">
                <TextBlock FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"
                                    Value="Nova promoção"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}"
                                             Value="True">
                                    <Setter Property="Text"
                                            Value="Editar promoção"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Text="Preencha os dados da promoção."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Formulário -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,0,0,16">

                <StackPanel>
                    <!-- Nome -->
                    <TextBlock Text="Nome *"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Text="{Binding Name,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="150"
                             ToolTip="Informe o nome da promoção"
                             Style="{StaticResource FieldControlStyle}"/>

                    <!-- Descrição -->
                    <TextBlock Text="Descrição"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Text="{Binding Description,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="500"
                             MinHeight="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             ToolTip="Descrição opcional da promoção"
                             Style="{StaticResource FieldControlStyle}"/>

                    <!-- Tipo de Desconto -->
                    <TextBlock Text="Tipo de Desconto *"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <ComboBox ItemsSource="{Binding DiscountTypes}"
                              SelectedItem="{Binding DiscountType, Mode=TwoWay}"
                              ToolTip="Selecione o tipo de desconto"
                              Style="{StaticResource FieldControlStyle}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumToDescriptionConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Valor do Desconto -->
                    <TextBlock Text="Valor do Desconto *"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBox Text="{Binding DiscountValue,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=LostFocus,
                                            StringFormat=N2}"
                             ToolTip="{Binding DiscountType, Converter={StaticResource EnumToDescriptionConverter}, ConverterParameter=Tooltip}"
                             Style="{StaticResource FieldControlStyle}"/>

                    <TextBlock x:Name="DiscountHint"
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,-10,0,16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Ex: 10 para 10%"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DiscountType}" Value="FixedAmount">
                                        <Setter Property="Text" Value="Ex: 5,00 para R$ 5,00 de desconto"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Data de Início -->
                    <TextBlock Text="Data de Início *"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}"
                                ToolTip="Data de início da vigência da promoção"
                                Style="{StaticResource FieldControlStyle}"/>

                    <!-- Data de Fim -->
                    <TextBlock Text="Data de Fim"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                ToolTip="Data de fim da vigência (opcional - deixar vazio para indefinido)"
                                Style="{StaticResource FieldControlStyle}"/>

                    <!-- Prioridade -->
                    <TextBlock Text="Prioridade *"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox Text="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Width="80"
                                 ToolTip="Prioridade da promoção (maior valor = maior prioridade)"
                                 Style="{StaticResource FieldControlStyle}"/>

                        <TextBlock Text="(maior valor = maior prioridade)"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Produtos Aplicáveis -->
                    <TextBlock Text="Produtos Aplicáveis"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock Text="Se nenhum produto for selecionado, a promoção se aplica a todos (global)."
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,0,0,8"/>

                    <Border BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="4"
                            MaxHeight="200"
                            Margin="0,0,0,16">
                        <ListView ItemsSource="{Binding Products}"
                                  SelectionMode="Multiple"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsActive}"
                                              Margin="8,4"
                                              FontSize="13"
                                              Foreground="#374151">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                        <Setter Property="ToolTip" Value="Produto inativo"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Categorias Aplicáveis -->
                    <TextBlock Text="Categorias Aplicáveis"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock Text="Se nenhuma categoria for selecionada, a promoção se aplica a todas (global)."
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,0,0,8"/>

                    <Border BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            CornerRadius="4"
                            MaxHeight="150"
                            Margin="0,0,0,16">
                        <ListView ItemsSource="{Binding Categories}"
                                  SelectionMode="Multiple"
                                  Background="Transparent"
                                  BorderThickness="0">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsActive}"
                                              Margin="8,4"
                                              FontSize="13"
                                              Foreground="#374151">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                        <Setter Property="ToolTip" Value="Categoria inativa"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Border>

                    <!-- Status Global -->
                    <CheckBox Content="Promoção Global (aplica-se a todos os produtos/categorias)"
                              IsChecked="{Binding IsGlobal, Mode=OneWay}"
                              FontSize="13"
                              Foreground="#2563EB"
                              FontWeight="SemiBold"
                              Margin="0,0,0,20"
                              IsEnabled="False"/>

                    <!-- Status: somente leitura -->
                    <TextBlock Text="Status"
                               Style="{StaticResource FieldLabelStyle}"/>

                    <TextBlock Margin="0,0,0,20"
                               FontSize="14"
                               FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Ativa"/>
                                <Setter Property="Foreground" Value="#15803D"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}"
                                                 Value="False">
                                        <Setter Property="Text" Value="Inativa"/>
                                        <Setter Property="Foreground"
                                                Value="#B91C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="O status da promoção é gerenciado pela listagem."
                               FontSize="12"
                               Foreground="#6B7280"
                               Margin="0,0,0,8"/>
                </StackPanel>
            </Border>

            <!-- Carregando -->
            <Border Grid.Row="1"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsLoadingProducts, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Carregando produtos..."
                           Foreground="#1D4ED8"
                           HorizontalAlignment="Center"/>
            </Border>

            <Border Grid.Row="1"
                    Background="#EFF6FF"
                    BorderBrush="#BFDBFE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10"
                    Margin="0,0,0,16"
                    Visibility="{Binding IsLoadingCategories, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="Carregando categorias..."
                           Foreground="#1D4ED8"
                           HorizontalAlignment="Center"/>
            </Border>

            <!-- Ação -->
            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,16,0,0">
                <Button Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButtonStyle}">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Cadastrar"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="Salvar alterações"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSaving}"
                                                     Value="True">
                                            <Setter Property="Text"
                                                    Value="Salvando..."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>